{
  "name": "frontend",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "scripts": {
    "start": "nodemon vite",
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build --force",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "mcp": "ruler apply",
    "mcp:revert": "ruler revert"
  },
  "dependencies": {
    "@fontsource/playfair-display": "^5.2.8",
    "@fontsource/roboto": "^5.2.10",
    "@fontsource/roboto-mono": "^5.2.8",
    "@fortawesome/fontawesome-svg-core": "^7.2.0",
    "@fortawesome/vue-fontawesome": "^3.1.3",
    "@mdi/font": "7.4.47",
    "nodemon": "^3.1.14",
    "pinia": "^3.0.4",
    "vue": "^3.5.30",
    "vue-i18n": "^11.3.0",
    "vue-router": "^5.0.3",
    "vuetify": "3.12.7"
  },
  "devDependencies": {
    "@intellectronica/ruler": "^0.3.37",
    "@tailwindcss/vite": "^4.2.1",
    "@tsconfig/node22": "^22.0.5",
    "@types/node": "^24.12.0",
    "@vitejs/plugin-vue": "6.0.7",
    "@vue/tsconfig": "^0.9.0",
    "eslint": "^9.39.4",
    "eslint-config-vuetify": "^4.3.4",
    "npm-run-all2": "^8.0.4",
    "sass-embedded": "1.100.0",
    "tailwindcss": "^4.2.1",
    "typescript": "~5.9.3",
    "unplugin-fonts": "^1.4.0",
    "vite": "7.3.3",
    "vite-plugin-vuetify": "2.1.3",
    "vitest": "^4.1.7",
    "vue-tsc": "^3.2.5"
  }
}
