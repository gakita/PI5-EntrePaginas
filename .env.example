# ========================================
# SERVIDOR
# ========================================
PORT=3000
NODE_ENV=development
CHATBOT_PAGE_PATH=/chatbot

# ========================================
# 🔒 SEGURANÇA - JWT
# ========================================
# IMPORTANTE: Gerar chaves FORTES (mínimo 32 caracteres aleatórios)
# Comando: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=abc123def456ghi789jkl012mno345pqrstuvwxyz123456
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=xyz987uvw654tsr321qpo918nml654kji321fedcba987654321098
JWT_REFRESH_EXPIRES_IN=7d

# ========================================
# 🔒 SEGURANÇA - CORS
# ========================================
# Domínios permitidos (separados por vírgula)
# DEV: http://localhost:5173,http://localhost:3000
# PROD: https://seu-frontend.com
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

ORACLE_USER=your_oracle_user
ORACLE_PASSWORD=your_oracle_password
ORACLE_CONNECT_STRING=your_oracle_connection_string
ORACLE_CONFIG_DIR=C:\path\to\oracle\network\admin
ORACLE_WALLET_LOCATION=C:\path\to\oracle\wallet
ORACLE_WALLET_PASSWORD=your_wallet_password

ORACLE_POOL_MIN=1
ORACLE_POOL_MAX=5
ORACLE_POOL_INCREMENT=1

# ── Gemini (LLM para o chat de recomendação) ──
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash-lite


GOOGLE_BOOKS_API_KEY=

# ── Recuperacao de senha por e-mail ──
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@example.com
SMTP_PASS=your_app_password
MAIL_FROM="Entre Paginas <your_email@example.com>"
SMTP_TIMEOUT_MS=5000
PASSWORD_RESET_FRONTEND_URL=http://localhost:5173/reset-password
PASSWORD_RESET_TOKEN_MINUTES=30

